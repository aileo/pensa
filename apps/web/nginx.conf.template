# The client calls /api relatively, so the upstream is resolved at runtime by envsubst —
# the official nginx entrypoint only substitutes variables that exist in the environment,
# which leaves nginx's own $uri, $host and $scheme untouched.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # Vite writes content hashes into these filenames, so they can never go stale.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single-page application: unknown routes are handled by the client, not by nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
