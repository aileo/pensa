# Pensa — every setting, with its default.
#
# Copy this file to .env next to your Compose file and uncomment what you want to change.
# Every line is commented out on purpose: copying it changes nothing, so the values that suit
# development cannot be imposed on a production instance by accident.
#
# Reference, with the effect of each variable: docs/deployment.md

# --- Database ---------------------------------------------------------------------------
# The API builds its connection from these fields. They also configure the db container in the
# Compose files, so setting POSTGRES_PASSWORD once is enough for both sides.
# Change the password before the first start: afterwards the database keeps the old one, and
# you have to reset it by hand.
#POSTGRES_USER=pensa
#POSTGRES_PASSWORD=pensa
#POSTGRES_DB=pensa
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
# Set this to use a database you host elsewhere. When present it wins over everything above.
#DATABASE_URL=postgres://user:password@host:5432/pensa

# --- API --------------------------------------------------------------------------------
# Port the API listens on inside its container. The Compose files never publish it on the host.
#PORT=3000
# Optional. The API accepts writes from the address the request was actually made to, so a
# reverse proxy needs no configuration here. Set a comma-separated list of origins to pin it.
# Development defaults to http://localhost:5173, the production stack to http://localhost:8080.
#WEB_ORIGIN=https://cadeaux.example.org
# Number of proxies in front of the API, so rate limits count the visitor and not the proxy.
# 1 is the web container, and stays right when your own reverse proxy sits in front of it.
#TRUST_PROXY=1

# --- Who can sign up --------------------------------------------------------------------
# true lets anyone with the URL create an account. Leave it false in production: the first
# account of an empty database is always allowed, so a closed instance can still be started,
# and everyone else joins with an invitation code.
#OPEN_REGISTRATION=false

# --- First account ----------------------------------------------------------------------
# Filled in, these create the first account on the first start, so a new instance is usable
# without touching the sign-up form. They are ignored once any account exists, so they are safe
# to leave in place — but the password is readable by anyone who can read this file, so change
# it after the first login.
# BOOTSTRAP_EMAIL switches the whole thing on; the next four are then required.
#BOOTSTRAP_EMAIL=you@example.org
#BOOTSTRAP_PASSWORD=change-me-after-first-login
#BOOTSTRAP_FIRST_NAME=Camille
#BOOTSTRAP_LAST_NAME=Durand
#BOOTSTRAP_BIRTH_DATE=1985-07-24
# Name of the household. Defaults to "Foyer de <first name>".
#BOOTSTRAP_HOUSEHOLD=Foyer Durand
# Optional. Creates the family too, with its default occasions, and makes the account its admin.
#BOOTSTRAP_FAMILY=Famille Durand

# --- Web container ----------------------------------------------------------------------
# Port published on the host. Point your reverse proxy at it.
#WEB_PORT=8080
# Where nginx forwards /api. Only worth changing if the API runs outside the stack.
#API_UPSTREAM=http://api:3000
# Images the Compose files pull. Override to run locally built images, or to pin an exact
# version such as ghcr.io/aileo/pensa-api:0.2.0.
#API_IMAGE=ghcr.io/aileo/pensa-api:latest
#WEB_IMAGE=ghcr.io/aileo/pensa-web:latest

# --- Development only -------------------------------------------------------------------
# Where the Vite dev server proxies /api. compose.yaml already sets it.
#VITE_API_PROXY_TARGET=http://api:3000
