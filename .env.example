DATABASE_URL=
PORT=3000
# Optional. The API accepts writes from the address the request was actually made to, so a
# reverse proxy needs no configuration here. Set a comma-separated list of origins to pin it.
WEB_ORIGIN=http://localhost:5173
# Number of proxies in front of the API, so rate limits count the visitor and not the proxy.
TRUST_PROXY=1
# Anyone can sign up without an invitation. Leave it false in production: the first account
# of an empty database is always allowed, so you can still bootstrap a closed instance.
OPEN_REGISTRATION=false
